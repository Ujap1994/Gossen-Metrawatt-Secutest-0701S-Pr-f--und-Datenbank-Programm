{
  "name": "secutest-pruefmanager",
  "productName": "Secutest Prüfmanager",
  "version": "2.0.0",
  "description": "Prüf- und Datenbankprogramm für den Gossen Metrawatt SECUTEST 0701S (DIN VDE 0701/0702) mit verschlüsselter Cloud-Datenbank, 2FA und Prüferinnerungen",
  "author": "Secutest Prüfmanager Projekt",
  "homepage": "https://github.com/Ujap1994/Gossen-Metrawatt-Secutest-0701S-Pr-f--und-Datenbank-Programm",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "app": "node node_modules/electron/install.js && electron .",
    "app:simulator": "node node_modules/electron/install.js && electron . --simulator",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "simulator": "node src/server.js --simulator",
    "reminders": "node scripts/send-reminders.js",
    "test": "node --test",
    "test:e2e": "node node_modules/electron/install.js && playwright test",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "express": "^4.22.3",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.pruefmanager.Secutest",
    "productName": "Secutest Pruefmanager",
    "copyright": "MIT-Lizenz · Open Source ohne Gewähr",
    "artifactName": "Secutest-Pruefmanager-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist/electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "scripts/send-reminders.js",
      "package.json",
      "LICENSE",
      "!**/*.{md,map,ts}",
      "!**/{test,tests,docs,example,examples}/**",
      "!node_modules/better-sqlite3-multiple-ciphers/{deps,src}/**",
      "!node_modules/@serialport/bindings-cpp/{src,binding.gyp}",
      "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/**",
      "node_modules/better-sqlite3-multiple-ciphers/prebuilds/${platform}-*.node",
      "!node_modules/@serialport/bindings-cpp/prebuilds/**",
      "node_modules/@serialport/bindings-cpp/prebuilds/${platform}*/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Der QR-Scanner liest Prüfplaketten mit der Kamera.",
        "CFBundleDisplayName": "Secutest Prüfmanager"
      },
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/**/*.node"
    },
    "dmg": {
      "title": "Secutest Prüfmanager ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Secutest Prüfmanager",
      "artifactName": "Secutest-Pruefmanager-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Secutest-Pruefmanager-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "secutest-pruefmanager",
      "maintainer": "Secutest Prüfmanager Projekt",
      "synopsis": "Prüf- und Datenbankprogramm für den SECUTEST 0701S",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Secutest Prüfmanager",
          "Comment": "Prüf- und Datenbankprogramm für den SECUTEST 0701S"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2",
        "libcups2t64 | libcups2",
        "libudev1"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(mesa-libgbm or libgbm1)",
        "(alsa-lib or libasound2)",
        "(cups-libs or libcups2)",
        "(systemd-libs or libudev1)"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "libxtst",
        "libnotify",
        "libsecret",
        "xdg-utils",
        "at-spi2-core",
        "libxkbcommon",
        "mesa",
        "alsa-lib",
        "libcups",
        "systemd-libs"
      ]
    }
  }
}
